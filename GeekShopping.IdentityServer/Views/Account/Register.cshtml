@model GeekShopping.IdentityServer.MainModule.Account.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create an account";
    ViewData["Pitch"] = "Create an account to save your cart and follow your orders.";
}

<h1>Create an account</h1>
<partial name="_ValidationSummary" />

<form asp-controller="Account" asp-action="Register" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="grid2">
        <label class="field">First name<input asp-for="FirstName" autocomplete="given-name" autofocus></label>
        <label class="field">Last name<input asp-for="LastName" autocomplete="family-name"></label>
    </div>
    <label class="field">Email<input asp-for="Email" type="email" autocomplete="email"></label>
    <label class="field">Username<input asp-for="Username" autocomplete="username"></label>
    <label class="field">Password<input type="password" asp-for="Password" autocomplete="new-password"></label>
    <div class="actions">
        <button class="btn btn-primary" name="button" value="Register">Create account</button>
    </div>
</form>
<p class="alt">Already have one? <a href="@Url.Action("Login", new { Model.ReturnUrl })">Sign in</a></p>
