@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    ViewData["Pitch"] = "Sign in to keep your cart, use your coupons and follow your orders.";
}

<h1>Sign in</h1>
<partial name="_ValidationSummary" />

@if (Model.EnableLocalLogin)
{
    <form asp-route="Login">
        <input type="hidden" asp-for="ReturnUrl" />
        <label class="field">Username<input asp-for="Username" autocomplete="username" autofocus></label>
        <label class="field">Password<input type="password" asp-for="Password" autocomplete="current-password"></label>
        @if (Model.AllowRememberLogin)
        {
            <div class="row-line"><label><input type="checkbox" class="form-check-input" asp-for="RememberLogin"> Remember me</label></div>
        }
        <div class="actions">
            <button class="btn btn-primary" name="button" value="login">Sign in</button>
            <button class="btn btn-secondary" name="button" value="cancel">Back to the store</button>
        </div>
    </form>
    <p class="alt">New here? <a href="@Url.Action("Register", new { Model.ReturnUrl })">Create an account</a></p>
}

@if (Model.VisibleExternalProviders.Any())
{
    <div class="external">
        <strong>Or sign in with</strong>
        <ul>
            @foreach (var provider in Model.VisibleExternalProviders)
            {
                <li>
                    <a class="btn btn-secondary" asp-controller="External" asp-action="Challenge"
                       asp-route-scheme="@provider.AuthenticationScheme" asp-route-returnUrl="@Model.ReturnUrl">@provider.DisplayName</a>
                </li>
            }
        </ul>
    </div>
}

@if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
{
    <div class="alert alert-danger">Sign-in is not available for this request: no login method is configured.</div>
}
