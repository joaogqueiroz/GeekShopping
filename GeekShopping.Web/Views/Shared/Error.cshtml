@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="prose">
    <h1>Something went wrong</h1>
    <p>The store could not finish this request. Try again in a moment; if it keeps happening, go back to the products and start over.</p>
    @if (Model.ShowRequestId)
    {
        <p class="tag">Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="form-actions"><a class="btn ink" asp-controller="Home" asp-action="Index">Back to products</a></div>
</div>
