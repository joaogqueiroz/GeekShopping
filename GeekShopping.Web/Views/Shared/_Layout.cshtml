<!DOCTYPE html>
<html lang="en">
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} - GeekShopping" : "GeekShopping")</title>
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <link rel="preload" href="~/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GeekShopping.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="top">
        <div class="in">
            <a class="logo" asp-controller="Home" asp-action="Index">Geek<b>Shopping</b></a>
            <nav aria-label="Main">
                <a asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" ? "page" : null)">Products</a>
                <a asp-controller="Product" asp-action="ProductIndex" aria-current="@(controller == "Product" ? "page" : null)">Manage products</a>
            </nav>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main role="main" class="page">
        @RenderBody()
    </main>

    <footer class="foot-bar">
        <div class="in">
            &copy; @DateTime.Now.Year GeekShopping, <a asp-controller="Home" asp-action="Privacy">privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
