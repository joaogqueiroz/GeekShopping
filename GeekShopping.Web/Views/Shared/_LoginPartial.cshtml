<div class="who">
    @if (User.Identity.IsAuthenticated)
    {
        <span class="greet">Hello, @User.Identity.Name</span>
        <a class="out" asp-controller="Home" asp-action="Logout">Log out</a>
    }
    else
    {
        <a class="out" asp-controller="Home" asp-action="Login">Sign in</a>
    }
    <a asp-controller="Cart" asp-action="CartIndex">Cart</a>
</div>
