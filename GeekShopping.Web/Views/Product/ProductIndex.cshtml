@model IEnumerable<GeekShopping.Web.Models.ProductViewModel>
@{
    ViewData["Title"] = "Manage products";
}

<div class="head-row">
    <div>
        <h1>Manage products</h1>
        <p class="lede">Everything listed in the store. Only administrators can delete a product.</p>
    </div>
    <a asp-action="ProductCreate" class="btn ink">Add a product</a>
</div>

<table class="admin">
    <thead>
        <tr><th><span class="visually-hidden">Image</span></th><th>Product</th><th>Category</th><th>Price</th><th><span class="visually-hidden">Actions</span></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><div class="thumb"><img src="@(item.ImageURL ?? "/images/product-placeholder.png")" alt=""></div></td>
                <td><h3 class="name">@item.Name</h3></td>
                <td class="tag">@item.CategoryName</td>
                <td>@item.Price.ToString("c")</td>
                <td class="acts">
                    <a asp-action="ProductUpdate" asp-route-id="@item.Id">Edit</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="ProductDelete" asp-route-id="@item.Id" class="del">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
