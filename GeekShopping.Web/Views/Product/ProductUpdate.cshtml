@model GeekShopping.Web.Models.ProductViewModel
@{
    ViewData["Title"] = "Edit product";
    ViewData["SubmitText"] = "Save changes";
}

<a class="back" asp-action="ProductIndex">Back to products</a>
<h1>Edit product</h1>

<form asp-action="ProductUpdate">
    <input asp-for="Id" type="hidden">
    <partial name="_ProductForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
