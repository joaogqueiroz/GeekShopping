@model GeekShopping.Web.Models.ProductViewModel
@{
    ViewData["Title"] = "Delete product";
}

<a class="back" asp-action="ProductIndex">Back to products</a>
<h1>Delete this product?</h1>

<form asp-action="ProductDelete">
    <input asp-for="Id" type="hidden">
    <div class="editor">
        <div class="panel">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mini-line"><span>Name</span><strong>@Model.Name</strong></div>
            <div class="mini-line"><span>Category</span><span>@Model.CategoryName</span></div>
            <div class="mini-line"><span>Price</span><span>@Model.Price.ToString("c")</span></div>
            <p class="warning">The product leaves the store right away. This cannot be undone.</p>
            <div class="form-actions">
                <button type="submit" class="btn danger">Delete product</button>
                <a asp-action="ProductIndex" class="btn ghost">Keep it</a>
            </div>
        </div>
        <article class="blister">
            <div class="window"><img src="@(Model.ImageURL ?? "/images/product-placeholder.png")" alt="@Model.Name"></div>
            <div class="cat">@Model.CategoryName</div>
            <h2 class="name">@Model.Name</h2>
            <p class="desc">@Model.Description</p>
            <div class="card-foot"><span class="sticker">@Model.Price.ToString("c")</span></div>
        </article>
    </div>
</form>
