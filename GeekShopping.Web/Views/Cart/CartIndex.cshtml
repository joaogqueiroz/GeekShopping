@model GeekShopping.Web.Models.CartViewModel
@{
    ViewData["Title"] = "Your cart";
}

@if (Model.CartHeader != null && Model.CartDetails != null && Model.CartDetails.Any())
{
    var discount = Model.CartHeader.DiscountTotal ?? 0;
    var total = Model.CartHeader.PurchaseAmount ?? 0;
    var hasCoupon = !string.IsNullOrEmpty(Model.CartHeader.CouponCode);

    <h1>Your cart</h1>
    <form method="post">
        <input asp-for="CartHeader.UserId" type="hidden" />
        <input asp-for="CartHeader.Id" type="hidden" />
        <div class="two-col">
            <div class="lines">
                @foreach (var item in Model.CartDetails)
                {
                    var count = item.Count ?? 0;
                    <div class="line">
                        <div class="thumb"><img src="@(item.Product.ImageURL ?? "/images/product-placeholder.png")" alt=""></div>
                        <div><h3>@item.Product.Name</h3><small>@item.Product.CategoryName</small></div>
                        <span class="unit">@count &times; @string.Format("{0:c}", item.Product.Price)</span>
                        <strong>@string.Format("{0:c}", item.Product.Price * count)</strong>
                        <a class="remove" asp-action="Remove" asp-route-id="@item.Id">Remove</a>
                    </div>
                }
            </div>
            <aside class="summary">
                <h2>Order summary</h2>
                <div class="coupon">
                    @if (hasCoupon)
                    {
                        <input asp-for="CartHeader.CouponCode" readonly aria-label="Coupon code" />
                        <button type="submit" asp-action="RemoveCoupon" class="btn ghost">Remove</button>
                    }
                    else
                    {
                        <input asp-for="CartHeader.CouponCode" placeholder="Coupon code" aria-label="Coupon code" />
                        <button type="submit" asp-action="ApplyCoupon" class="btn ghost">Apply</button>
                    }
                </div>
                @if (discount > 0)
                {
                    <div class="applied">Coupon applied: @string.Format("{0:c}", discount) off</div>
                }
                <div class="sum" style="margin-top:12px"><span>Products</span><span>@string.Format("{0:c}", total + discount)</span></div>
                @if (discount > 0)
                {
                    <div class="sum disc"><span>Coupon</span><span>&minus; @string.Format("{0:c}", discount)</span></div>
                }
                <div class="sum total"><span>Total</span><span>@string.Format("{0:c}", total)</span></div>
                <a asp-action="Checkout" class="btn ink">Go to checkout</a>
            </aside>
        </div>
    </form>
}
else
{
    <div class="empty">
        <h1>Your cart is empty</h1>
        <p>Pick a figure, a shirt or a book and it shows up here.</p>
        <a class="btn ink" asp-controller="Home" asp-action="Index">See the products</a>
    </div>
}
