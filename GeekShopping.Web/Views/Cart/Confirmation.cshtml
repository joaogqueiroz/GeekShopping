@{
    ViewData["Title"] = "Order placed";
}

<div class="done">
    <span class="sticker">Order placed</span>
    <h1>Thanks. Your order is in.</h1>
    <p>We received your order and are processing the payment now.</p>
    <ol class="steps">
        <li><span><strong>Payment</strong><br><small>Your card details go to the payment service.</small></span></li>
        <li><span><strong>Order updated</strong><br><small>Once the payment is approved, the order is marked as paid.</small></span></li>
    </ol>
    <a class="btn ink" asp-controller="Home" asp-action="Index">Keep shopping</a>
</div>
