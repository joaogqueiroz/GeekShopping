@model GeekShopping.Web.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<a class="back" asp-action="Index">Back to products</a>

<form method="post">
    <input asp-for="Id" type="hidden">
    <div class="product">
        <div class="blister">
            <div class="window">
                <img src="@(Model.ImageURL ?? "/images/product-placeholder.png")" alt="@Model.Name">
            </div>
        </div>
        <div class="pinfo">
            <div class="cat">@Model.CategoryName</div>
            <h1>@Model.Name</h1>
            <span class="sticker">@Model.Price.ToString("c")</span>
            <p>@Model.Description</p>
            <div class="qty">
                <div class="stepper" data-stepper>
                    <button type="button" data-step="-1" aria-label="One less">&minus;</button>
                    <input asp-for="Count" type="number" min="1" max="100" aria-label="Quantity">
                    <button type="button" data-step="1" aria-label="One more">+</button>
                </div>
                <button type="submit" class="btn ink">Add to cart</button>
            </div>
            <span asp-validation-for="Count" class="text-danger"></span>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
