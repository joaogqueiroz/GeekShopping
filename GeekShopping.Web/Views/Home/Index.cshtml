@model IEnumerable<GeekShopping.Web.Models.ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<h1>Collectibles, shirts and books for people who know the lore</h1>
<p class="lede">Star Wars figures, SpaceX shirts, a Darth Vader helmet and a few things to read between launches.</p>

<div class="shelf">
    @foreach (var product in Model)
    {
        <article class="blister">
            <div class="window">
                <img src="@(product.ImageURL ?? "/images/product-placeholder.png")" alt="@product.Name" loading="lazy">
            </div>
            <div class="cat">@product.CategoryName</div>
            <h2 class="name">@product.Name</h2>
            <p class="desc">@product.Description</p>
            <div class="card-foot">
                <span class="sticker">@string.Format("{0:c}", product.Price)</span>
                <a class="btn ghost" asp-action="Details" asp-route-id="@product.Id" aria-label="Details of @product.Name">Details</a>
            </div>
        </article>
    }
</div>
